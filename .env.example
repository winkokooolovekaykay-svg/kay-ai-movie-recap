# ============================================================
# KAY AI MOVIE RECAP — environment configuration
# Copy to .env and fill in. NEVER commit .env with real keys.
# ============================================================

# --- AI (Gemini) : translation, recap, language detection, STT fallback ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Text-to-Speech provider ---
# "google" = Google Cloud Text-to-Speech (recommended, has my-MM Burmese voices)
# "none"   = TTS disabled (UI will say an API key is required)
TTS_PROVIDER=none
GOOGLE_TTS_API_KEY=
# Optional: pin a default voice, e.g. my-MM-Standard-A
TTS_DEFAULT_VOICE=

# --- Local speech-to-text (optional) ---
# If faster-whisper is pip-installed, it is used before Gemini.
WHISPER_MODEL=small

# --- Limits ---
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_MIN=120
DATA_DIR=./data

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- First admin account (created on first boot if missing) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
